{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "generator",
        "evaluator",
        "planner",
        "critic",
        "repairer",
        "chat"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "outputContract": {
      "default": "text",
      "type": "string",
      "enum": [
        "markdown",
        "evaluation_json",
        "patch",
        "command_plan",
        "text"
      ]
    },
    "contextPaths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeoutSeconds": {
      "default": 300,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxTurns": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "allowedTools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workdir": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "effort": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resumeSessionId": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "role",
    "prompt"
  ]
}

# Example systemd unit for team memory gatekeeper on Linux VM.
# Install: copy to /etc/systemd/system/agentctl-memory-serve.service, edit paths, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agentctl-memory-serve
#
# TLS: terminate at Caddy/NGINX; bind serve to 127.0.0.1 only.

[Unit]
Description=agentctl memory gatekeeper (POST /v1/context, /v1/turn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentctl
Group=agentctl
WorkingDirectory=/var/lib/agentctl
Environment=AGENTCTL_HOME=/var/lib/agentctl/team
Environment=AGENTCTL_SERVE_HOST=127.0.0.1
Environment=AGENTCTL_SERVE_PORT=8741
# Client laptops / Pi (not on this unit — set in shell profile):
# Environment=AGENTCTL_GATEWAY_URL=https://memory.example.com
# Environment=AGENTCTL_BRIEFING_WORKSPACE=team-atlas
# Environment=AGENTCTL_USER_ID=you@example.com
# Environment=AGENTCTL_GROUPS=your-team
# Environment=AGENTCTL_SERVE_MODEL_AGENT=codex
# Environment=AGENTCTL_SERVE_DEFAULT_RUN_MODEL=0
Environment=AGENTCTL_LAYA_EVIDENCE=1
Environment=AGENTCTL_LAYA_WARM=1
ExecStart=/usr/local/bin/agentctl memory serve --host 127.0.0.1 --port 8741
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentctl/team
PrivateTmp=true

[Install]
WantedBy=multi-user.target

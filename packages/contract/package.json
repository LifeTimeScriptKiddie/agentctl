{
  "name": "@lifetimescriptkiddie/shared-ptr-contract",
  "version": "1.0.0",
  "description": "Wire contract for the shared_ptr team-memory server: zod schemas for every /v1 route, the resume-briefing packet, prompt formatters and local conventions.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@lifetimescriptkiddie/agentctl-kit": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LifeTimeScriptKiddie/shared_ptr.git",
    "directory": "contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "@shared_ptr/server",
  "version": "0.1.0",
  "private": true,
  "description": "shared_ptr: team memory for AI agents (store, gatekeeper server, briefings). Split from agentctl.",
  "type": "module",
  "bin": {
    "shared_ptr": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/laya_evidence.py"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test:postgres": "sh scripts/test-postgres.sh"
  },
  "dependencies": {
    "@agentctl/kit": "0.1.0",
    "@shared_ptr/contract": "1.0.0",
    "commander": "^12.1.0",
    "execa": "^9.5.0",
    "pg": "^8.23.0",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "license": "MIT"
}

{
  "name": "@lifetimescriptkiddie/agentctl-kit",
  "version": "0.1.0",
  "description": "Security and state helpers shared by agentctl and shared_ptr: secret redaction, untrusted-text quoting, destructive-intent detection, private files, app home.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./appHome": {
      "types": "./dist/appHome.d.ts",
      "import": "./dist/appHome.js"
    },
    "./privateFs": {
      "types": "./dist/privateFs.d.ts",
      "import": "./dist/privateFs.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "import": "./dist/redact.js"
    },
    "./untrusted": {
      "types": "./dist/untrusted.d.ts",
      "import": "./dist/untrusted.js"
    },
    "./destructive": {
      "types": "./dist/destructive.d.ts",
      "import": "./dist/destructive.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LifeTimeScriptKiddie/agentctl.git",
    "directory": "packages/kit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "@lifetimescriptkiddie/agentctl",
  "version": "0.2.0",
  "description": "Backend-neutral CLI and library for orchestrating local AI agent CLIs, browsers, and containers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentctl": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run gen:specs && tsc && node scripts/copy-assets.mjs && node scripts/build-pi.mjs",
    "gen:specs": "tsx scripts/gen-specs.ts",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.0",
    "neo-blessed": "^0.2.0",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "author": "LifeTimeScriptKiddie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LifeTimeScriptKiddie/agentctl.git"
  },
  "homepage": "https://github.com/LifeTimeScriptKiddie/agentctl#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agentctl",
    "orchestration"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/pi/agentctl.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
